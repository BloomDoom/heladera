# Copy this file to ".env" and fill in the values from
# Supabase → Project Settings → API (or "API Keys").
# Vite only exposes variables that start with VITE_ to the app.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key.
# It's safe in the frontend: Row Level Security protects the data.
VITE_SUPABASE_KEY=your-publishable-key

# Only for loading the recipe book (scripts/recipes/load.js): put the
# secret key (Project Settings → API Keys → secret / service_role) in a
# file called .env.local, never here and never in the app. It skips all
# security rules.
# SUPABASE_SERVICE_KEY=
